{
  "Orleans": {
    "Cluster": {
      "ClusterId": "devicesocket-prod",
      "ServiceId": "devicesocket",
      "SiloPort": 11111,
      "GatewayPort": 30000,
      "AdvertisedIPAddress": "127.0.0.1"
    },
    "Persistence": {
      "ConnectionString": "Server=localhost;Database=DeviceSocketOrleans;Integrated Security=True;TrustServerCertificate=True",
      "Schema": "orleans_app",
      "CommandTimeoutSeconds": 30,
      "AutoCreateSchema": true,
      "Tables": {
        "Device": "OrleansDeviceState",
        "Command": "OrleansDeviceCommandState",
        "Gateway": "OrleansGatewayNodeState",
        "Scheduler": "OrleansDeviceCommandSchedulerState"
      }
    },
    "CommandScheduling": {
      "ShardCount": 1024,
      "RecoveryHorizon": "00:02:00",
      "RecoveryPeriod": "00:01:00",
      "BatchSize": 256,
      "MaxBatchesPerTick": 8,
      "DevicePumpLimit": 16,
      "MaxSameDeviceBatchSize": 100,
      "DefaultCommandTtl": "00:05:00",
      "DefaultResponseTimeout": "00:00:10",
      "DefaultMaxAttempts": 5,
      "EnqueueRecoveryDelay": "00:00:30",
      "RoutePersistenceInterval": "00:00:30",
      "UncertainRetryDelay": "00:00:05",
      "RetryDelayMilliseconds": [ 1000, 3000, 10000, 30000 ],
      "PayloadRetentionDays": 7,
      "CommandRetentionDays": 30,
      "CleanupScanIntervalMinutes": 15,
      "CleanupBatchSize": 200,
      "CleanupMaxBatchesPerRun": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Orleans": "Information"
    }
  }
}
