# 要运行的 DeviceSocket.Host 镜像和固定版本；升级或回滚时只修改这一项。
DEVICE_SOCKET_IMAGE=devicesocket-host:1.0.0

# 应用配置目录；必须包含 appsettings.json 和 serilog.json 两个只读配置文件。
DEVICE_SOCKET_CONFIG_DIR=/data/config/devicesocket

# 持久化日志目录；必须预先创建并授权给容器内 UID/GID 1654。
DEVICE_SOCKET_LOG_DIR=/data/logs/devicesocket

# 8 核 16 GiB 专用主机的容器内存上限；13g 为压测起始值，不包含宿主机其余进程。
DEVICE_SOCKET_MEMORY_LIMIT=13g

# Docker 的内存加 Swap 总上限；与内存上限相同表示不允许容器额外使用 Swap。
DEVICE_SOCKET_MEMORY_SWAP_LIMIT=13g

# 容器时区；影响本地时间显示，程序内部 Trace 时间仍应使用 UTC。
DEVICE_SOCKET_TIME_ZONE=Asia/Shanghai
