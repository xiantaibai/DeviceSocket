# 要部署的镜像。生产环境建议使用明确版本或不可变 digest。
DEVICE_SOCKET_IMAGE=devicesocket-host:1.0.0
DEVICE_SOCKET_CONTAINER_NAME=devicesocket-host

# 8 核 16 GiB 专用主机的起始限制；压测后再根据峰值调整。
DEVICE_SOCKET_MEMORY_LIMIT=13g
DEVICE_SOCKET_MEMORY_SWAP_LIMIT=13g
DEVICE_SOCKET_TIME_ZONE=Asia/Shanghai

# 宿主机持久化日志目录，运行前必须创建并授权给 UID/GID 1654。
DEVICE_SOCKET_LOG_DIR=/data/devicesocket/logs

# Gateway 节点身份。多台 Gateway 必须使用不同 NodeId。
GATEWAY_NODE_ID=gateway-linux-01

# 当前 compose 用于单节点 TCP 层部署，默认不连接 Orleans。
ORLEANS_ENABLED=false

# TCP 连接容量。MAX_CONNECTIONS_PER_IP=0 表示不限制 NAT 出口下的单 IP 连接数。
MAX_CONNECTIONS=85000
MAX_UNAUTHENTICATED_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=0
MAX_CONNECTIONS_PER_SECOND=5000

# 小报文长连接默认使用 4 KiB 缓冲，放大前必须通过 Linux 压测验证内存收益。
RECEIVE_BUFFER_SIZE=4096
SEND_BUFFER_SIZE=4096
