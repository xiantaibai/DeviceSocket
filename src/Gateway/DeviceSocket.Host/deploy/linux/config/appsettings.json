{
  "DeviceSocket": {
    // HTTP 状态和调试 API 监听端口；默认 5080，单位为 TCP 端口号。
    "HttpPort": 5080,
    "Listeners": {
      "QGdw3761": {
        // Q/GDW 376.1 监听地址；Any 表示监听全部 IPv4 地址。
        "Ip": "Any",
        // Q/GDW 376.1 设备接入端口；默认 5001。
        "Port": 5001,
        // 已完成握手但尚未被应用 Accept 的连接队列长度，不是在线设备连接上限。
        "BackLog": 4096,
        // true 表示禁用 Nagle 算法，降低设备小报文发送延迟。
        "NoDelay": true
      },
      "Dlt645": {
        // DL/T 645-2007 监听地址；Any 表示监听全部 IPv4 地址。
        "Ip": "Any",
        // DL/T 645-2007 设备接入端口；默认 5002。
        "Port": 5002,
        // 两个协议端口独立配置，便于根据各自的集中重连压力进行压测调整。
        "BackLog": 4096,
        // true 表示禁用 Nagle 算法，降低设备小报文发送延迟。
        "NoDelay": true
      }
    },
    "ConnectionLimit": {
      // 8 万条目标连接上方保留 5 千条接入余量；最终值必须由目标 Linux 主机压测确认。
      "MaxConnections": 85000,
      // 尚未登录或绑定设备的最大连接数；默认 5000 条，防止匿名连接占满总容量。
      "MaxUnauthenticatedConnections": 5000,
      // 零表示不限制单 IP 连接数，兼容运营商 NAT 和少量压测源 IP。
      "MaxConnectionsPerIp": 0,
      // 零表示关闭每秒接入限制；默认每秒最多接受 5000 条新连接。
      "MaxConnectionsPerSecond": 5000,
      // Session 完成登录或首帧设备绑定的期限；默认 30 秒。
      "LoginTimeoutSeconds": 30,
      // 已认证 Session 没有合法协议帧的最长时间；默认 420 秒。
      "IdleTimeoutSeconds": 420,
      // 传输层和协议层空闲扫描周期；默认 30 秒。
      "IdleScanIntervalSeconds": 30,
      // 单轮扫描最多并发关闭的 Session 数；默认 128 条。
      "MaxConcurrentSessionCloses": 128,
      // 连续非法协议帧达到该数量后关闭连接；默认 5 条。
      "MaxConsecutiveProtocolErrors": 5,
      // 单次异步下发总超时；默认 15 秒，超时会关闭失效 Session。
      "SendTimeoutSeconds": 15,
      // 单 Session 同时等待或执行的下发消息上限；默认 16 条。
      "MaxPendingSendMessagesPerSession": 16,
      // 单 Session 同时等待或执行的下发数据上限；默认 65536 字节。
      "MaxPendingSendBytesPerSession": 65536,
      // 整个 Gateway 同时等待或执行的下发数据上限；默认 256 MiB。
      "MaxPendingSendBytes": 268435456,
      // 小报文长连接使用 4 KiB 缓冲，放大前必须验证吞吐收益和每连接内存影响。
      "ReceiveBufferSize": 4096,
      // 每条连接的发送缓冲起始值；默认 4096 字节，放大会增加 Socket 内存压力。
      "SendBufferSize": 4096,
      // 单条协议包允许占用的处理时间；默认 10 秒。
      "PackageHandlingTimeoutSeconds": 10,
      // true 表示启用 TCP KeepAlive；关闭后仍保留协议层合法报文空闲清理。
      "TcpKeepAliveEnabled": true,
      // Socket 空闲多久后开始 KeepAlive 探测；默认 180 秒。
      "TcpKeepAliveTimeSeconds": 180,
      // 相邻 KeepAlive 探测间隔；默认 30 秒。
      "TcpKeepAliveIntervalSeconds": 30,
      // 连续探测失败次数；默认 3 次，达到后由操作系统判定连接失效。
      "TcpKeepAliveRetryCount": 3
    }
  },
  "Gateway": {
    // 多台 Gateway 必须使用不同 NodeId；单节点 TCP 压测也应保留稳定名称。
    "NodeId": "gateway-linux-01",
    // MagicOnion RPC 监听端口；默认 7001。
    "RpcPort": 7001,
    // 跨主机启用 Orleans 前必须改成其他服务能够访问的 Gateway 内网地址。
    "RpcEndpoint": "http://127.0.0.1:7001",
    // 设备路由租约有效期；默认 60 秒。
    "RouteLeaseSeconds": 60,
    // Gateway 节点租约有效期；默认 30 秒。
    "NodeLeaseSeconds": 30,
    // Gateway 节点续租周期；默认 10 秒，必须小于节点租约有效期。
    "NodeHeartbeatSeconds": 10
  },
  "Orleans": {
    // 当前 Compose 用于单节点 TCP 层部署，默认不连接 Orleans Silo。
    "Enabled": false,
    // 本地主机 Orleans Gateway 端口；默认 30000，仅启用 Orleans 时生效。
    "GatewayPort": 30000
  },
  // ASP.NET Core Host 请求头限制；* 表示接受任意 Host，生产公网入口应由反向代理收敛。
  "AllowedHosts": "*"
}
