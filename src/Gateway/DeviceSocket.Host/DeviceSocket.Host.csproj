<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\DeviceSocket.Core\DeviceSocket.Core.csproj" />
    <ProjectReference Include="..\..\Shared\DeviceSocket.Rpc.Contracts\DeviceSocket.Rpc.Contracts.csproj" />
    <ProjectReference Include="..\..\Cluster\DeviceSocket.Cluster.Contracts\DeviceSocket.Cluster.Contracts.csproj" />
    <ProjectReference Include="..\..\Infrastructure\DeviceSocket.Infrastructure.Memory\DeviceSocket.Infrastructure.Memory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Configuration\Logging\serilog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SuperSocket.Server" Version="2.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="MagicOnion.Server" Version="7.10.2" />
    <PackageReference Include="Microsoft.Orleans.Client" Version="8.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

</Project>
