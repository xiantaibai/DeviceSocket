{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devicesocket.local/schemas/debugger-command-set.schema.json",
  "title": "DeviceSocket 调试指令集",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "protocol", "defaultPort", "groups"],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "enum": ["QGdw3761", "Dlt6452007"]
    },
    "defaultPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commands"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "inputs", "response"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "mode": {
          "enum": ["codec", "raw", "layout"]
        },
        "encoder": {
          "type": "string"
        },
        "rawHex": {
          "type": ["string", "null"]
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "fixedValues": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "response": {
          "$ref": "#/$defs/response"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layoutField"
          }
        }
      }
    },
    "layoutField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["fixed", "input", "computed", "copy"]
        },
        "value": {
          "type": "string"
        },
        "inputKey": {
          "type": "string"
        },
        "encoding": {
          "enum": ["hex", "hexAdd33", "bcdReverse", "byte"]
        },
        "algorithm": {
          "enum": ["byteLength", "qgdw3761Length", "sum8"]
        },
        "fromField": {
          "type": "string"
        },
        "toField": {
          "type": "string"
        },
        "copyField": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "endian": {
          "enum": ["little", "big"]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["text", "number", "hex", "select", "datetime"]
        },
        "default": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    }
  }
}
