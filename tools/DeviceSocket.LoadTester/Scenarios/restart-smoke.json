{
  "target": {
    "host": "127.0.0.1",
    "port": 5001,
    "protocol": "qGdw3761"
  },
  "devices": {
    "count": 10,
    "addressStart": 101,
    "administrativeDivision": "3301"
  },
  "connection": {
    "startMode": "burst",
    "connectionsPerSecond": 100,
    "maxConcurrentConnecting": 10,
    "connectTimeoutSeconds": 2,
    "loginTimeoutSeconds": 2,
    "writeTimeoutSeconds": 2,
    "noDelay": true
  },
  "heartbeat": {
    "enabled": true,
    "intervalSeconds": 3,
    "jitterSeconds": 0,
    "responseTimeoutSeconds": 2
  },
  "workload": {
    "reportsEnabled": false,
    "reportIntervalSeconds": 60,
    "jitterSeconds": 5
  },
  "reconnect": {
    "mode": "immediate",
    "initialDelayMilliseconds": 0,
    "maximumDelaySeconds": 0,
    "multiplier": 2,
    "jitterRatio": 0,
    "maximumAttempts": 0
  },
  "scenario": {
    "name": "restart-smoke",
    "durationSeconds": 1,
    "phases": [
      {
        "name": "warmup",
        "kind": "warmup",
        "durationSeconds": 5,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 100
      },
      {
        "name": "restart-gateway-now",
        "kind": "fault",
        "durationSeconds": 15,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 1000
      },
      {
        "name": "recovery",
        "kind": "recovery",
        "durationSeconds": 30,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 1000
      },
      {
        "name": "cooldown",
        "kind": "cooldown",
        "durationSeconds": 1,
        "targetDevicePercentage": 0,
        "connectionsPerSecond": 100
      }
    ]
  },
  "reporting": {
    "outputDirectory": "load-test-results",
    "sampleIntervalSeconds": 1,
    "writeConsoleSummary": true
  },
  "serverObservation": {
    "enabled": true,
    "statusUrl": "http://127.0.0.1:5080/api/status/connections",
    "timeoutSeconds": 1
  },
  "acceptance": {
    "minimumFinalOnlineRate": 0.99,
    "maximumProtocolErrorRate": 0.01,
    "maximumRecoverySeconds": 20,
    "minimumObservedAuthenticatedDevices": 10
  },
  "distributed": {
    "runId": "restart-smoke-local",
    "shardIndex": 0,
    "shardCount": 1
  }
}
