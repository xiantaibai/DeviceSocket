{
  "target": {
    "host": "127.0.0.1",
    "port": 5001,
    "protocol": "qGdw3761"
  },
  "devices": {
    "count": 100,
    "addressStart": 1001,
    "administrativeDivision": "3301",
    "duplicateIdentityPercentage": 20
  },
  "connection": {
    "startMode": "burst",
    "connectionsPerSecond": 1000,
    "maxConcurrentConnecting": 100,
    "connectTimeoutSeconds": 3,
    "loginTimeoutSeconds": 3,
    "writeTimeoutSeconds": 3
  },
  "heartbeat": {
    "enabled": true,
    "intervalSeconds": 5,
    "jitterSeconds": 1,
    "responseTimeoutSeconds": 3
  },
  "reconnect": {
    "mode": "fixed",
    "initialDelayMilliseconds": 1000,
    "maximumDelaySeconds": 1,
    "multiplier": 1,
    "jitterRatio": 0,
    "maximumAttempts": 0
  },
  "scenario": {
    "name": "duplicate-login",
    "durationSeconds": 30
  },
  "reporting": {
    "outputDirectory": "load-test-results",
    "sampleIntervalSeconds": 1,
    "writeConsoleSummary": true
  },
  "serverObservation": {
    "enabled": true,
    "statusUrl": "http://127.0.0.1:5080/api/status/connections",
    "timeoutSeconds": 2
  },
  "acceptance": {
    "minimumFinalOnlineRate": 0.95,
    "maximumProtocolErrorRate": 0.01,
    "minimumObservedAuthenticatedDevices": 80,
    "maximumObservedAuthenticatedDevices": 80
  },
  "distributed": {
    "runId": "duplicate-login-local",
    "shardIndex": 0,
    "shardCount": 1
  }
}
