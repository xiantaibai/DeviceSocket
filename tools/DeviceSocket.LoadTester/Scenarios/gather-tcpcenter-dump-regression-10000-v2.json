{
  // 当前进程同时维持一万台 TCP 虚拟设备并调用老业务 HTTP API；极限测试时可拆成 devicesOnly 与 apiOnly 两台负载机。
  "role": "combined",

  "target": {
    // 老 Gather.TcpCenter 的公司内网地址；执行正式前后对比时必须保持地址、端口和部署机器不变。
    "host": "192.168.111.18",
    // 老 TCP 服务监听端口，对应 dump 中运行实例的 6666 端口。
    "port": 6666,
    // 使用 Q/GDW 376.1 协议模拟集中器登录、心跳和读表应答。
    "protocol": "qGdw3761",
    // 启用老 Gather.TcpCenter 确认帧、地址和读表下发兼容行为，不能改成新 Gateway 配置。
    "compatibilityProfile": "gatherTcpCenter"
  },

  "devices": {
    // 全局模拟设备总数；多机分片时仍填写 10000，由 shardIndex/shardCount 自动分摊。
    "count": 10000,
    // 从 CSV 读取数据库中真实存在的集中器编号和电表编号，避免随机设备被老服务判定为未录入。
    "generationMode": "csv",
    // 路径相对当前场景文件解析；每行格式为 meterId,deviceId，必须包含一万条不重复映射。
    "deviceMappingFile": "gather-device-10000.csv"
  },

  "connection": {
    // ramp 表示受 connectionsPerSecond 限速，避免客户端本机瞬时建连先成为瓶颈；场景中的阶段可覆盖具体速率。
    "startMode": "ramp",
    // 默认每秒最多发起 300 次连接，阶段没有单独配置时使用该值。
    "connectionsPerSecond": 300,
    // 同时处于 DNS/TCP 建连过程的本地会话上限，防止一万任务同时阻塞在 ConnectAsync。
    "maxConcurrentConnecting": 500,
    // TCP 建连等待上限，单位秒；超时后按 reconnect 策略自动重连。
    "connectTimeoutSeconds": 5,
    // 376.1 登录确认等待上限，单位秒；该指标用于观察服务端回调阻塞和连接锁竞争。
    "loginTimeoutSeconds": 5,
    // 单次 Socket 写入等待上限，单位秒；避免服务端或网络拥塞永久占用设备任务。
    "writeTimeoutSeconds": 5,
    // 关闭 Nagle 算法，使登录、心跳和短指令帧立即发送，降低客户端批量延迟对结果的干扰。
    "noDelay": true
  },

  "heartbeat": {
    // 启用协议心跳，这是本场景复现 dump 中同步 Redis LPUSH 热路径的关键流量。
    "enabled": true,
    // 每台在线设备每 60 秒发送一次心跳，接近真实终端周期。
    "intervalSeconds": 60,
    // 在正负 10 秒范围打散心跳，作为正式容量对比口径；需要极限同步冲击时另建 jitter=0 的专项场景。
    "jitterSeconds": 10,
    // 等待老服务心跳确认帧的上限，单位秒；超时会触发设备断线和指数退避重连。
    "responseTimeoutSeconds": 5
  },

  "workload": {
    // 不发送普通周期上报，避免上报流量掩盖登录、心跳和 HTTP 下发导致的服务端瓶颈。
    "reportsEnabled": false,
    // 普通上报周期，单位秒；reportsEnabled=false 时不生效，但保留明确值便于复用场景。
    "reportIntervalSeconds": 300,
    // 普通上报随机抖动，单位秒；reportsEnabled=false 时不生效。
    "jitterSeconds": 30,
    "gatherReadingResponse": {
      // 收到老 TCP 服务下发的读表命令后生成符合 376.1 的终端应答。
      "enabled": true,
      // normal 表示按正常业务成功路径应答；异常、延迟和重复应答应使用独立专项场景。
      "mode": "normal",
      // 所有收到读表命令的虚拟设备都参与应答。
      "affectedDevicePercentage": 100,
      // 模拟终端采集电表数据耗时，单位毫秒；一秒延迟用于制造真实在途命令窗口。
      "delayMilliseconds": 1000,
      // 读表应答包含四个费率数据项，保持改造前后业务报文完全一致。
      "rateCount": 4,
      // 第一台设备的基础读数，单位 kWh，仅影响模拟业务数据，不影响协议关联。
      "baseReadingKwh": 1000,
      // 相邻设备读数递增量，单位 kWh，用于避免一万台设备返回完全相同的数据。
      "deviceStepKwh": 0.01
    }
  },

  "commandWorkload": {
    // 启用独立 HTTP 工作队列调用老业务读表接口；HTTP 与 TCP 接收循环互不复用工作队列。
    "enabled": true,
    // 老 Gather.Control.Api 根地址，正式执行前确认该地址与待测 TCP 服务属于同一套环境。
    "baseUrl": "http://192.168.111.18:9011",
    // 触发老业务服务向集中器下发读表命令的接口路径。
    "endpointPath": "/api/ammeter/reading",
    // 老接口鉴权请求头名称；空值表示完全不发送鉴权头。
    "authorizationHeaderName": "gather-authorize-key",
    // 从指定环境变量读取鉴权值，报告只记录变量名，不会记录密钥；当前空值表示测试环境不需要鉴权值。
    "authorizationKeyEnvironmentVariable": "",
    // 请求体 oper_uid，固定 0 表示压测专用操作人，正式环境可替换为审计要求的测试账号编号。
    "operatorUserId": 0,
    // 老项目 OperationSource.Test 的数值 6，用于区分真实用户操作和压测流量。
    "operationSource": 6,
    // 普通 376.1 抄读模式，保持与老接口默认行为一致。
    "readingModel": 0,
    // 老接口 readingCode 透传值，0 表示默认读表代码。
    "readingCode": 0,
    // 单次 HTTP 请求最大等待 70 秒，覆盖老 API 最长 60 秒同步业务等待。
    "requestTimeoutSeconds": 70,
    // 阶段未配置 minimumOnlineCount 时，按本地设备数的 98% 计算默认在线门槛。
    "requiredOnlineRate": 0.98,
    // 阶段未覆盖时必须连续满足在线门槛 30 秒才开始请求，避免刚达到峰值就立刻下发。
    "onlineStableSeconds": 30,
    // 阶段未覆盖时最长等待在线 600 秒；超时后的默认阶段行为由 onlineGateFailureAction 决定。
    "onlineWaitTimeoutSeconds": 600,
    // combined 模式不额外固定等待，改用每个阶段的真实在线门槛控制启动。
    "startDelaySeconds": 0,
    "phases": [
      {
        // 用 100 台设备验证接口字段、下发帧和终端应答闭环，失败时仍继续后续 TCP 场景。
        "name": "functional-sync-100",
        "targetDeviceCount": 100,
        "requestsPerDevice": 1,
        "requestsPerSecond": 10,
        "maxConcurrency": 10,
        "showResult": true,
        "pauseAfterSeconds": 10,
        "minimumOnlineCount": 100,
        "onlineStableSeconds": 10,
        "onlineWaitTimeoutSeconds": 120,
        "onlineGateFailureAction": "skipPhase"
      },
      {
        // 在至少一千台稳定在线后进行中等规模异步请求，保证一万容量失败时仍有可比较的 HTTP 数据。
        "name": "devices-1000-async-once",
        "targetDeviceCount": 1000,
        "requestsPerDevice": 1,
        "requestsPerSecond": 100,
        "maxConcurrency": 30,
        "showResult": false,
        "pauseAfterSeconds": 20,
        "minimumOnlineCount": 1000,
        "onlineStableSeconds": 20,
        "onlineWaitTimeoutSeconds": 300,
        "onlineGateFailureAction": "skipPhase"
      },
      {
        // 在第一容量台阶达到 4900 在线后向五千台设备各下发一次，用于公平比较改造前后的命令吞吐。
        "name": "devices-5000-async-once",
        "targetDeviceCount": 5000,
        "requestsPerDevice": 1,
        "requestsPerSecond": 200,
        "maxConcurrency": 50,
        "showResult": false,
        "pauseAfterSeconds": 30,
        "minimumOnlineCount": 4900,
        "onlineStableSeconds": 30,
        "onlineWaitTimeoutSeconds": 600,
        "onlineGateFailureAction": "skipPhase"
      },
      {
        // 向一千台设备连续压入五条命令，验证单设备命令串行、应答关联和队头阻塞。
        "name": "same-device-queue-1000x5",
        "targetDeviceCount": 1000,
        "requestsPerDevice": 5,
        "requestsPerSecond": 200,
        "maxConcurrency": 100,
        "showResult": false,
        "pauseAfterSeconds": 60,
        "minimumOnlineCount": 1000,
        "onlineStableSeconds": 20,
        "onlineWaitTimeoutSeconds": 300,
        "onlineGateFailureAction": "skipPhase"
      },
      {
        // 使用同步等待结果模式制造老 API 订阅和请求线程压力，目标规模控制在一百台以避免先压垮业务 API。
        "name": "same-device-sync-100x5",
        "targetDeviceCount": 100,
        "requestsPerDevice": 5,
        "requestsPerSecond": 20,
        "maxConcurrency": 20,
        "showResult": true,
        "pauseAfterSeconds": 60,
        "minimumOnlineCount": 1000,
        "onlineStableSeconds": 20,
        "onlineWaitTimeoutSeconds": 300,
        "onlineGateFailureAction": "skipPhase"
      },
      {
        // 最后一阶段只有达到 9800 在线并稳定 30 秒才向一万台各下发一次；不满足时明确记为跳过而不是中止报告。
        "name": "all-devices-10000-async-once",
        "targetDeviceCount": 10000,
        "requestsPerDevice": 1,
        "requestsPerSecond": 200,
        "maxConcurrency": 50,
        "showResult": false,
        "pauseAfterSeconds": 60,
        "minimumOnlineCount": 9800,
        "onlineStableSeconds": 30,
        "onlineWaitTimeoutSeconds": 600,
        "onlineGateFailureAction": "skipPhase"
      }
    ]
  },

  "reconnect": {
    // 使用指数退避并叠加随机抖动，避免客户端超时后每 250 毫秒同步重连进一步放大服务端雪崩。
    "mode": "exponentialJitter",
    // 第一次重连最短等待 250 毫秒。
    "initialDelayMilliseconds": 250,
    // 连续失败时单次退避最长 10 秒，防止设备长时间离线又避免无限高频连接。
    "maximumDelaySeconds": 10,
    // 每次失败把基础退避扩大为上一轮的两倍，达到 maximumDelaySeconds 后封顶。
    "multiplier": 2,
    // 在基础退避上增加正负 50% 随机量，用于打散一万台设备的重连时间。
    "jitterRatio": 0.5,
    // 零表示不限制重连次数，设备会在整个场景期间持续模拟真实终端自动恢复。
    "maximumAttempts": 0
  },

  "scenario": {
    // 场景名称会写入控制台和报告；RunId 可由命令行覆盖以区分改造前、改造后和重复轮次。
    "name": "gather-tcpcenter-dump-regression-10000-v2",
    // 配置 phases 后该值仅作兼容占位，不决定总时长。
    "durationSeconds": 1,
    "phases": [
      {
        // 先连接 100 台验证网络、协议、数据库设备映射和 HTTP 功能闭环。
        "name": "canary-100",
        "kind": "warmup",
        "durationSeconds": 30,
        "targetDevicePercentage": 1,
        "connectionsPerSecond": 25
      },
      {
        // 提升到五千台，主要观测旧版全局锁和 List 线性查找在第一容量台阶的影响。
        "name": "ramp-5000",
        "kind": "ramp",
        "durationSeconds": 180,
        "targetDevicePercentage": 50,
        "connectionsPerSecond": 200
      },
      {
        // 五千台保持五分钟，确保产生多轮心跳并为五千台 HTTP 阶段提供稳定窗口。
        "name": "steady-5000",
        "kind": "steady",
        "durationSeconds": 300,
        "targetDevicePercentage": 50,
        "connectionsPerSecond": 200
      },
      {
        // 从五千台提升到一万台，连接速率与旧测试保持 300/s，便于改造前后直接比较。
        "name": "ramp-10000",
        "kind": "ramp",
        "durationSeconds": 300,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 300
      },
      {
        // 一万台保持十五分钟，覆盖登录、心跳、Redis 写入和全部 HTTP 指令阶段。
        "name": "steady-10000",
        "kind": "steady",
        "durationSeconds": 900,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 300
      },
      {
        // 一次性主动断开全部虚拟设备，模拟 TCP 服务重启或公司内网瞬时中断后的设备风暴重连。
        "name": "disconnect-all-10000",
        "kind": "fault",
        "durationSeconds": 180,
        "targetDevicePercentage": 100,
        "faults": {
          "disconnectPercentage": 100,
          "disconnectBatchSize": 10000,
          "disconnectIntervalMilliseconds": 0
        }
      },
      {
        // 保持目标一万台并观察十分钟，统计恢复到 9800 在线所需时间和恢复期间心跳确认率。
        "name": "recovery-10000",
        "kind": "recovery",
        "durationSeconds": 600,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 300
      },
      {
        // 正常关闭全部虚拟设备并等待资源释放；测量快照保留上一非冷却阶段，不会被最终在线零覆盖。
        "name": "cooldown",
        "kind": "cooldown",
        "durationSeconds": 30,
        "targetDevicePercentage": 0
      }
    ]
  },

  "reporting": {
    // 报告根目录；最终文件位于 outputDirectory/runId/shard-xxx 下。
    "outputDirectory": "load-test-results",
    // 每秒记录一次 node-timeseries.jsonl，足以观察 dump 中约五秒 CPU 峰值和在线锯齿。
    "sampleIntervalSeconds": 1,
    // 每十秒原子覆盖 run-checkpoint.json，LoadTester 被强制结束时仍保留最近累计指标。
    "checkpointIntervalSeconds": 10,
    // 控制台输出实时摘要；关闭只减少终端文本，不影响 JSONL、检查点和最终报告。
    "writeConsoleSummary": true
  },

  "serverObservation": {
    // 老 Gather.TcpCenter 没有 DeviceSocket Gateway 状态接口，因此默认关闭；服务端 CPU、线程和 Redis 指标需用 PerfMon/Redis INFO 同步采集。
    "enabled": false
  },

  "acceptance": {
    // 整轮连接成功率最低 95%；连接风暴中的所有失败尝试都会进入分母。
    "minimumConnectionSuccessRate": 0.95,
    // 登录确认成功率最低 95%，用于发现 HP-Socket 回调和 Redis 同步操作造成的五秒超时。
    "minimumLoginSuccessRate": 0.95,
    // 恢复阶段最终协议在线率最低 98%。
    "minimumFinalOnlineRate": 0.98,
    // 一万设备目标下最终至少 9800 台协议在线。
    "minimumFinalOnlineCount": 9800,
    // 协议解析和异常帧错误率最高 1%。
    "maximumProtocolErrorRate": 0.01,
    // 全断后恢复到目标在线率最长 120 秒。
    "maximumRecoverySeconds": 120,
    // 主动全断场景至少应产生一万次重连调度，否则说明故障注入没有覆盖全部设备。
    "minimumReconnects": 10000,
    // 已实际执行的 HTTP 请求业务成功率最低 98%；被在线门槛跳过的阶段单独按运行状态判定失败。
    "minimumApiSuccessRate": 0.98,
    // 收到老服务读表下发后成功发送终端应答的比例最低 99%。
    "minimumGatherReadingResponseRate": 0.99,
    // HTTP 端到端 P95 最长 70 秒，与单请求超时保持一致，超过即判定业务链路阻塞。
    "maximumApiP95Milliseconds": 70000
  },

  "distributed": {
    // 默认运行编号；正式 A/B 测试建议通过 --run-id 分别覆盖为 before-r1、after-r1 等唯一值。
    "runId": "gather-tcpcenter-dump-regression-10000-v2",
    // 当前节点分片编号从零开始；单机运行固定为 0。
    "shardIndex": 0,
    // 负载节点总数；单机运行固定为 1，多机时所有节点必须配置相同总数和设备 CSV。
    "shardCount": 1
  }
}
