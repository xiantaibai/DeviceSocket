    "maxConcurrentConnecting": 500,
    "connectTimeoutSeconds": 5,
    "loginTimeoutSeconds": 5,
    "writeTimeoutSeconds": 5,
    "noDelay": true
  },
  "heartbeat": {
    "enabled": true,
    "intervalSeconds": 120,
    "jitterSeconds": 15,
    "responseTimeoutSeconds": 5
  },
  "workload": {
    "reportsEnabled": false,
    "reportIntervalSeconds": 300,
    "jitterSeconds": 30
  },
  "reconnect": {
    "mode": "exponentialJitter",
    "initialDelayMilliseconds": 500,
    "maximumDelaySeconds": 30,
    "multiplier": 2,
    "jitterRatio": 0.3,
    "maximumAttempts": 0
