{
  "target": {
    "host": "gateway.example.com",
    "port": 5001,
    "protocol": "qGdw3761"
  },
  "devices": {
    "count": 80000,
    "addressStart": 1,
    "administrativeDivision": "3301",
    "spanAdministrativeDivisions": true
  },
