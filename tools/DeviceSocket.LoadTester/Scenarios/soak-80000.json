  "scenario": {
    "name": "soak-80000",
    "durationSeconds": 1,
    "phases": [
      {
        "name": "ramp",
        "kind": "ramp",
        "durationSeconds": 240,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 1000
      },
      {
        "name": "six-hour-soak",
