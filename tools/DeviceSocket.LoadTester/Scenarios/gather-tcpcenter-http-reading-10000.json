{
  // 标准 8 核 16 GiB 测试服务器场景：一万台真实设备保持在线，同时调用读表 API 并模拟终端业务应答。
  "role": "combined",
  "target": {
    "host": "192.168.111.222",
    "port": 6666,
    "protocol": "qGdw3761",
    "compatibilityProfile": "gatherTcpCenter"
  },
  "devices": {
    // 多分片仍填写全局总数；每个节点使用同一份完整 CSV，再按数据行全局序号取模分配。
    "count": 10000,
    "generationMode": "csv",
    // Gather 兼容模式允许 CSV 中数据库真实存在的特殊终端地址 00000；标准376.1模式仍会拒绝该地址。
    "deviceMappingFile": "gather-device-10000.csv"
  },
  "connection": {
    "startMode": "ramp",
    // 所有分片合计速率，工具会按 shardCount 精确分摊，不会随负载机数量放大。
    "connectionsPerSecond": 300,
    "maxConcurrentConnecting": 500,
    "connectTimeoutSeconds": 5,
    "loginTimeoutSeconds": 5,
    "writeTimeoutSeconds": 5,
    "noDelay": true
  },
  "heartbeat": {
    "enabled": true,
    "intervalSeconds": 60,
    "jitterSeconds": 10,
    "responseTimeoutSeconds": 5
  },
  "workload": {
    "reportsEnabled": false,
    "reportIntervalSeconds": 300,
    "jitterSeconds": 30,
    "gatherReadingResponse": {
      // 收到 Gather AFN=0CH/F129 读表命令后生成老 CmdCenter 可解析的 A15/A14 业务应答。
      "enabled": true,
      "mode": "normal",
      "affectedDevicePercentage": 100,
      // 模拟真实终端采集耗时，单位毫秒。
      "delayMilliseconds": 1000,
      "rateCount": 4,
      "baseReadingKwh": 1000,
      "deviceStepKwh": 0.01
    }
  },
  "commandWorkload": {
    // combined 模式从本进程真正在线的设备中选取目标，避免向已离线 meterId 发起无效请求。
    "targetDeviceSource": "onlineRegistry",
    "enabled": true,
    // 运行前替换为与 TCP 服务同一套环境的 Gather.Control.Api 地址。
    "baseUrl": "http://192.168.111.18:9011",
    "endpointPath": "/api/ammeter/reading",
    "authorizationHeaderName": "gather-authorize-key",
    // 需要鉴权时设置为 GATHER_AUTHORIZE_KEY，并只在进程环境变量中保存密钥；空值表示不发送鉴权头。
    "authorizationKeyEnvironmentVariable": "",
    "operatorUserId": 0,
    "operationSource": 6,
    "readingModel": 0,
    "readingCode": 0,
    "requestTimeoutSeconds": 70,
    // 无论当前 HTTP 阶段只抽多少设备，都必须先等全部一万台业务在线，避免连接爬升和指令负载相互污染。
    "minimumOnlineCount": 10000,
    "requiredOnlineRate": 0.98,
    "onlineStableSeconds": 60,
    "onlineWaitTimeoutSeconds": 1200,
    "startDelaySeconds": 0,
    "phases": [
      {
        // 小样本同步冒烟先验证 API、TCP 下发、设备应答和结果订阅闭环；失败即停止，避免制造无效大流量。
        "name": "functional-sync-smoke-20",
        "targetDeviceCount": 20,
        "requestsPerDevice": 1,
        "requestsPerSecond": 2,
        "maxConcurrency": 5,
        "showResult": true,
        "pauseAfterSeconds": 10,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.95,
        "maximumP95Milliseconds": 70000,
        "drainEnabled": true,
        // 原始下行与协议识别分开验收，避免正式服务变更报文格式时误报“服务端未下发”。
        "minimumRawDeliveryRate": 0.95,
        "minimumDeliveryRate": 0.95,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 180,
        "quietSeconds": 10,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 10,
        "maximumTimeoutRate": 0.1,
        "circuitBreakerMinimumRequests": 10,
        "circuitBreakerAction": "abortRun"
      },
      {
        // 先以 5 RPS 验证服务端命令消费可以追平，再逐级增加；每级都必须排空后才进入下一级。
        "name": "async-ramp-5rps",
        "targetDeviceCount": 500,
        "requestsPerDevice": 1,
        "requestsPerSecond": 5,
        "maxConcurrency": 10,
        "showResult": false,
        "pauseAfterSeconds": 10,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 300,
        "quietSeconds": 15,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 20,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 20,
        "circuitBreakerAction": "abortRun"
      },
      {
        "name": "async-ramp-10rps",
        "targetDeviceCount": 500,
        "requestsPerDevice": 1,
        "requestsPerSecond": 10,
        "maxConcurrency": 20,
        "showResult": false,
        "pauseAfterSeconds": 10,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 300,
        "quietSeconds": 15,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 20,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 20,
        "circuitBreakerAction": "abortRun"
      },
      {
        "name": "async-ramp-20rps",
        "targetDeviceCount": 500,
        "requestsPerDevice": 1,
        "requestsPerSecond": 20,
        "maxConcurrency": 40,
        "showResult": false,
        "pauseAfterSeconds": 10,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 300,
        "quietSeconds": 15,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 20,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 20,
        "circuitBreakerAction": "abortRun"
      },
      {
        "name": "async-ramp-50rps",
        "targetDeviceCount": 500,
        "requestsPerDevice": 1,
        "requestsPerSecond": 50,
        "maxConcurrency": 80,
        "showResult": false,
        "pauseAfterSeconds": 15,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 300,
        "quietSeconds": 15,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 20,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 20,
        "circuitBreakerAction": "abortRun"
      },
      {
        // 一万台各提交一次异步命令；50 RPS 是本轮基准值，确认前四级都能排空后再提高。
        "name": "all-devices-async-once",
        "targetDeviceCount": 0,
        "requestsPerDevice": 1,
        "requestsPerSecond": 50,
        "maxConcurrency": 100,
        "showResult": false,
        "pauseAfterSeconds": 30,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 900,
        "quietSeconds": 20,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 600,
        "maximumConsecutiveFailures": 50,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 100,
        "circuitBreakerAction": "abortRun"
      },
      {
        // 向 1000 台在线设备各连续提交 5 条异步命令，验证同设备队列与队头阻塞。
        "name": "same-device-queue-1000x5",
        "targetDeviceCount": 1000,
        "requestsPerDevice": 5,
        "requestsPerSecond": 50,
        "maxConcurrency": 100,
        "showResult": false,
        "pauseAfterSeconds": 30,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.98,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.98,
        "minimumDeliveryRate": 0.98,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 900,
        "quietSeconds": 20,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 600,
        "maximumConsecutiveFailures": 50,
        "maximumTimeoutRate": 0.05,
        "circuitBreakerMinimumRequests": 100,
        "circuitBreakerAction": "abortRun"
      },
      {
        // 最后再次执行小样本同步闭环，检查大流量后结果订阅是否退化或阻塞。
        "name": "final-sync-20x2",
        "targetDeviceCount": 20,
        "requestsPerDevice": 2,
        "requestsPerSecond": 2,
        "maxConcurrency": 5,
        "showResult": true,
        "pauseAfterSeconds": 0,
        "onlineGateFailureAction": "abortRun",
        "minimumApiSuccessRate": 0.95,
        "maximumP95Milliseconds": 70000,
        "drainEnabled": true,
        "minimumRawDeliveryRate": 0.95,
        "minimumDeliveryRate": 0.95,
        "minimumResponseRate": 0.99,
        "drainTimeoutSeconds": 300,
        "quietSeconds": 10,
        "drainFailureAction": "abortRun",
        "circuitBreakerEnabled": true,
        "maximumDurationSeconds": 300,
        "maximumConsecutiveFailures": 10,
        "maximumTimeoutRate": 0.1,
        "circuitBreakerMinimumRequests": 10,
        "circuitBreakerAction": "abortRun"
      }
    ]
  },
  "reconnect": {
    "mode": "exponentialJitter",
    "initialDelayMilliseconds": 250,
    "maximumDelaySeconds": 10,
    "multiplier": 2,
    "jitterRatio": 0.5,
    "maximumAttempts": 0
  },
  "scenario": {
    "name": "gather-tcpcenter-http-reading-10000",
    "durationSeconds": 1,
    "phases": [
      {
        "name": "canary-100",
        "kind": "warmup",
        "durationSeconds": 30,
        "targetDevicePercentage": 1,
        "connectionsPerSecond": 25
      },
      {
        "name": "ramp-1000",
        "kind": "ramp",
        "durationSeconds": 90,
        "targetDevicePercentage": 10,
        "connectionsPerSecond": 100
      },
      {
        "name": "ramp-5000",
        "kind": "ramp",
        "durationSeconds": 180,
        "targetDevicePercentage": 50,
        "connectionsPerSecond": 200
      },
      {
        "name": "ramp-10000",
        "kind": "ramp",
        "durationSeconds": 300,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 300
      },
      {
        // HTTP 工作负载未结束时，运行器会继续保持设备在线，不会提前进入 cooldown。
        "name": "command-steady-10000",
        "kind": "steady",
        "durationSeconds": 1200,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 300
      },
      {
        "name": "cooldown",
        "kind": "cooldown",
        "durationSeconds": 30,
        "targetDevicePercentage": 0,
        "connectionsPerSecond": 300
      }
    ]
  },
  "reporting": {
    "outputDirectory": "load-test-results",
    "sampleIntervalSeconds": 1,
    "checkpointIntervalSeconds": 10,
    "writeConsoleSummary": true,
    "downstreamDiagnostics": {
      // 保存逐请求闭环，并按相同报文指纹最多保留 5 条未知格式样本供协议排障。
      "enabled": true,
      "captureUnknownFrames": true,
      "maxSamplesPerFingerprint": 5,
      "maxTotalSamples": 500,
      "rawHexMaxBytes": 512,
      // 覆盖最长 900 秒排空窗口，防止慢服务下发失去请求关联。
      "correlationTimeoutSeconds": 1200
    }
  },
  "serverObservation": {
    "enabled": false
  },
  "acceptance": {
    "minimumConnectionSuccessRate": 0.95,
    "minimumLoginSuccessRate": 0.95,
    "minimumFinalOnlineRate": 0.98,
    "minimumFinalOnlineCount": null,
    "maximumProtocolErrorRate": 0.01,
    "minimumApiSuccessRate": 0.98,
    "minimumApiTargetCoverageRate": 0.98,
    "minimumGatherReadingResponseRate": 0.99,
    "maximumApiP95Milliseconds": 70000,
    "minimumAsyncApiAcceptanceRate": 0.98,
    "minimumSyncResultSuccessRate": 0.95,
    "minimumCommandDeliveryRate": 0.98,
    "minimumCommandRecognitionRate": 0.98,
    "maximumUnobservedCommands": 200
  },
  "distributed": {
    "runId": "gather-http-reading-10000",
    "shardIndex": 0,
    "shardCount": 1
  }
}
