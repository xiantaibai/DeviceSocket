{
  "target": {
    "host": "127.0.0.1",
    "port": 5001,
    "protocol": "qGdw3761"
  },
  "devices": {
    "count": 10000,
    "addressStart": 1,
    "administrativeDivision": "3301"
  },
  "connection": {
    "startMode": "ramp",
    "connectionsPerSecond": 1000,
    "maxConcurrentConnecting": 500,
    "connectTimeoutSeconds": 5,
    "loginTimeoutSeconds": 5,
    "writeTimeoutSeconds": 5,
    "noDelay": true
  },
  "heartbeat": {
    "enabled": true,
    "intervalSeconds": 60,
    "jitterSeconds": 10,
    "responseTimeoutSeconds": 5
  },
  "workload": {
    "reportsEnabled": false,
    "reportIntervalSeconds": 300,
    "jitterSeconds": 10
  },
  "reconnect": {
    "mode": "immediate",
    "initialDelayMilliseconds": 0,
    "maximumDelaySeconds": 0,
    "multiplier": 2,
    "jitterRatio": 0,
    "maximumAttempts": 0
  },
  "scenario": {
    "name": "restart-storm",
    "durationSeconds": 1,
    "phases": [
      {
        "name": "warmup",
        "kind": "warmup",
        "durationSeconds": 30,
        "targetDevicePercentage": 10,
        "connectionsPerSecond": 200
      },
      {
        "name": "full-load",
        "kind": "ramp",
        "durationSeconds": 90,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 1000
      },
      {
        "name": "restart-gateway-now",
        "kind": "fault",
        "durationSeconds": 120,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 5000
      },
      {
        "name": "recovery",
        "kind": "recovery",
        "durationSeconds": 180,
        "targetDevicePercentage": 100,
        "connectionsPerSecond": 5000
      },
      {
        "name": "cooldown",
        "kind": "cooldown",
        "durationSeconds": 5,
        "targetDevicePercentage": 0,
        "connectionsPerSecond": 1000
      }
    ]
  },
  "reporting": {
    "outputDirectory": "load-test-results",
    "sampleIntervalSeconds": 1,
    "writeConsoleSummary": true
  },
  "serverObservation": {
    "enabled": true,
    "statusUrl": "http://127.0.0.1:5080/api/status/connections",
    "timeoutSeconds": 2
  },
  "acceptance": {
    "minimumFinalOnlineRate": 0.99,
    "maximumProtocolErrorRate": 0.01,
    "maximumRecoverySeconds": 120,
    "minimumObservedAuthenticatedDevices": 9900
  },
  "distributed": {
    "runId": "replace-restart-run-id",
    "shardIndex": 0,
    "shardCount": 1
  }
}
