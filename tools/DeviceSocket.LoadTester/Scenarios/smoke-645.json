{
  "target": {
    "host": "127.0.0.1",
    "port": 5002,
    "protocol": "dlt6452007"
  },
  "devices": {
    "count": 10,
    "addressStart": 1,
    "administrativeDivision": "3301"
  },
  "connection": {
    "startMode": "ramp",
    "connectionsPerSecond": 10,
    "maxConcurrentConnecting": 10,
    "connectTimeoutSeconds": 3,
