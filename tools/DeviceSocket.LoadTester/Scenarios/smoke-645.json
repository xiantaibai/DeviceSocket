    "reportsEnabled": true,
    "reportIntervalSeconds": 10,
    "jitterSeconds": 2
  },
  "reconnect": {
    "mode": "exponentialJitter",
    "initialDelayMilliseconds": 500,
    "maximumDelaySeconds": 10,
    "multiplier": 2,
